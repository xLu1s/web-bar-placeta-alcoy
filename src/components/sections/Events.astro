---
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';
---

<section class="section section--dark" id="eventos">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <span class="eyebrow eyebrow--gold">{site.events.eyebrow}</span>
      <h2>{site.events.title}</h2>
      <p>{site.events.lead}</p>
    </div>

    <div class="grid grid--3">
      {site.events.items.map((item) => (
        <article class="event-card" data-reveal>
          <span class="event-card__icon">
            <Icon name={item.icon} size={26} />
          </span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>

    <div class="section-head section-head--center" style="margin-top:2.5rem;margin-bottom:0" data-reveal>
      <a class="btn btn--gold btn--lg" href={site.contact.phoneHref}>
        <Icon name="phone" size={20} />
        {site.events.cta}
      </a>
    </div>
  </div>
</section>
